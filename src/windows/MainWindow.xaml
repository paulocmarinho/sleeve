<Window x:Class="Sleeve.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sleeve"
        Width="1200" Height="760"
        MinWidth="320" MinHeight="64"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F5F5F7"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

  <!-- Janela sem a barra do Windows: a interface desenha a própria barra.
       A sombra e o encaixe nas bordas da tela continuam funcionando. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  ResizeBorderThickness="0"
                  GlassFrameThickness="0,0,0,1"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Border x:Name="Root">
    <wv2:WebView2 x:Name="Web" />
  </Border>
</Window>
